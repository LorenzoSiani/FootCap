# Local PostgreSQL test database (Task 0.5.10D; ADR-015).
# Points at the disposable `db` service defined in compose.yaml -- never a
# production database. postgres/postgres are fixed, non-secret local-only
# credentials for that disposable container; it is reachable only from
# localhost and is safe to commit.
FOOTCAP_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/footcap_test
